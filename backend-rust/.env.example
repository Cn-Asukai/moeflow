# Copy to .env or run deploy.ps1/deploy.sh to generate local secrets.
# Never commit .env. Generated passwords use hex so MongoDB URI encoding is safe.
MONGO_USERNAME=moeflow
MONGO_PASSWORD=
MONGO_APP_PASSWORD=
JWT_SECRET=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
SESSION_TTL_SECONDS=604800

# A real private Tencent COS bucket is REQUIRED for uploads and exports.
# Bucket includes account suffix, e.g. mybucket-1250000000.
COS_REGION=
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=
# Optional bucket origin override; not an AWS S3 emulator endpoint.
COS_ENDPOINT=
USER_STORAGE_QUOTA_BYTES=1073741824
TEAM_STORAGE_QUOTA_BYTES=107374182400
MAX_UPLOAD_BYTES=5368709120
MAX_ACTIVE_UPLOADS_PER_USER=8
MAX_ACTIVE_UPLOADS_PER_TEAM=32
MAX_EXPORT_INPUT_BYTES=536870912
MAX_EXPORT_TEXT_BYTES=67108864
MAX_EXPORT_SOURCES=100000

# Local Compose Mailpit captures verification emails at localhost:8025.
# Production: set a real SMTP host, port, TLS and credentials.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="MoeFlow <noreply@moeflow.local>"
SMTP_TLS=none
MAIL_UI_PORT=8025

# OpenAI-compatible multimodal endpoint; credentials are server-side only.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
JOB_CONCURRENCY=4
JOB_HEAVY_CONCURRENCY=1

# Expired unbound/temp/output cleanup can run without business backup confirmation.
GC_ENABLED=true
RESOURCE_PROTECTION_ENABLED=true
# Set true ONLY after database+objects restore protection is operational.
RESOURCE_BACKUP_CONFIRMED=false
RUST_LOG=moeflow_backend=info,tower_http=info

# Optional registry overrides (e.g. public.ecr.aws/docker/library/...).
RUST_IMAGE=rust:1.90-bookworm
RUNTIME_IMAGE=debian:bookworm-slim
NODE_IMAGE=node:22-bookworm-slim
NGINX_IMAGE=nginx:1.28-alpine
MONGO_IMAGE=mongo:7.0
MAILPIT_IMAGE=ghcr.io/axllent/mailpit:v1.27
